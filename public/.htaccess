<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /pos/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /pos/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, no-store, must-revalidate" env=REDIRECT_no_cache
  # App shell + update files must always be revalidated, or browsers keep serving an old
  # index.html (which points at old hashed bundles) after a deploy.
  <FilesMatch "^(index\.html|sw\.js|workbox-.*\.js|registerSW\.js|version\.json|manifest\.webmanifest|server-info\.php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
